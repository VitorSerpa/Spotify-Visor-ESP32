CONFIG_IDF_TARGET="esp32"

# 4 MB de flash e tabela de particoes propria (app de 3.75 MB, ver partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Bundle de CAs publicas: necessario para o HTTPS do endpoint.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Sem PSRAM a heap e curta; reduzir os buffers de TLS libera ~20 KB.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# A conexao fica de pe entre as consultas (keep-alive), entao os dados de
# configuracao e o certificado da CA so servem durante o handshake.
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# O handshake TLS leva mais que o timeout padrao do watchdog em rede ruim.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# O WiFi reserva ~48 KB de buffers dimensionados para throughput alto. Aqui a
# rede busca ~18 KB a cada 15 s, entao esses buffers sao folga pura -- e a
# memoria que eles liberam e o que permite a capa redonda de 200x200.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_MAX_SOCKETS=4

# Display: confirmado na placa com um padrao de faixas de cor solida.
# Sem swap_xy o painel recebe o desenho transposto.
CONFIG_LCD_SWAP_XY=y

# LVGL
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# A fonte japonesa passa do limite de indice de 16 bits do formato padrao.
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
