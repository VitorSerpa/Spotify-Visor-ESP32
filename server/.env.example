# Copie para .env (local) ou cadastre como variáveis de ambiente na hospedagem.
# O .env está no .gitignore: nunca commite os valores reais.

# App criado em https://developer.spotify.com/dashboard (Settings > Basic Information)
CLIENT_ID=
CLIENT_SECRET=

# Precisa ser idêntica a uma Redirect URI cadastrada no app do Spotify.
# Local:     http://127.0.0.1:3000/callback
# Produção:  https://<seu-servidor>/callback
REDIRECT_URI=http://127.0.0.1:3000/callback

# Senha que o display usa para acessar o servidor. Gere uma aleatória:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e use o mesmo valor no firmware (menuconfig > SPOTIFY_API_KEY).
API_KEY=

# Preenchido depois do login em /auth_spotify?key=<API_KEY> (ver README).
REFRESH_TOKEN=

# Opcional. A maioria das hospedagens define PORT sozinha.
# PORT=3000
